# ─── HTTP server ────────────────────────────────────────────────
PORT=8787
# Public base URL clients connect to (used in returned profile/review URLs)
PUBLIC_BASE_URL=http://localhost:8787

# ─── Database (Postgres) ────────────────────────────────────────
DATABASE_URL=postgres://hiring:hiring@localhost:5433/hiring

# ─── Object storage (S3 / MinIO) ────────────────────────────────
# For MinIO local dev these defaults match docker-compose.yml.
# For AWS S3: drop S3_ENDPOINT, set real region + credentials.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hiring-session-logs
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO needs path-style addressing; AWS S3 does not.
S3_FORCE_PATH_STYLE=true

# ─── Secrets ────────────────────────────────────────────────────
# Bearer token for the admin JSON API and the recruiter console login.
# With NODE_ENV=production, default/short (<16 char) values are refused at boot.
ADMIN_TOKEN=change-me-admin-token
# Secret used to sign candidate/recruiter web-session cookies. Same boot check.
SESSION_SECRET=change-me-session-secret
# Days a minted/reissued candidate token stays valid.
TOKEN_TTL_DAYS=90

# ─── LinkedIn SSO (Sign In with LinkedIn / OpenID Connect) ──────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Defaults to <PUBLIC_BASE_URL>/auth/linkedin/callback if unset.
LINKEDIN_REDIRECT_URI=
# Dev-only mock of the OIDC flow (sign in as any identity). EXPLICIT opt-in;
# the server refuses to boot with this set in production.
LINKEDIN_MOCK=true

# ─── Feature flags ──────────────────────────────────────────────
# Require a verified session-log upload before a candidate can apply.
# When true the session-log MCP tools are registered and gate readiness.
REQUIRE_SESSION_LOG=false

# Optional: webhook POSTed on every new application (Slack-compatible `text`).
APPLICATION_WEBHOOK_URL=
