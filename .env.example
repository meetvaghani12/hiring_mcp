# ─── HTTP server ────────────────────────────────────────────────
PORT=8787
# Public base URL clients connect to (used in returned profile/review URLs)
PUBLIC_BASE_URL=http://localhost:8787

# ─── Database (Postgres) ────────────────────────────────────────
DATABASE_URL=postgres://hiring:hiring@localhost:5433/hiring

# ─── Object storage (S3 / MinIO) ────────────────────────────────
# For MinIO local dev these defaults match docker-compose.yml.
# For AWS S3: drop S3_ENDPOINT, set real region + credentials.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hiring-session-logs
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO needs path-style addressing; AWS S3 does not.
S3_FORCE_PATH_STYLE=true

# ─── Admin API ──────────────────────────────────────────────────
# Bearer token for the admin REST surface (mint candidate tokens, manage roles).
ADMIN_TOKEN=change-me-admin-token
# Secret used to sign candidate web-session cookies.
SESSION_SECRET=change-me-session-secret
# Days a minted/reissued candidate token stays valid.
TOKEN_TTL_DAYS=90

# ─── LinkedIn SSO (Sign In with LinkedIn / OpenID Connect) ──────
# Leave blank + LINKEDIN_MOCK=true to test the full flow without a LinkedIn app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Defaults to <PUBLIC_BASE_URL>/auth/linkedin/callback if unset.
LINKEDIN_REDIRECT_URI=
# Mock mode auto-enables when no client id is set; force with true/false.
LINKEDIN_MOCK=true

# ─── Feature flags ──────────────────────────────────────────────
# Require an uploaded session log before application_ready can be true.
REQUIRE_SESSION_LOG=true
